{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "frota-radical",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "frota",
      "database_id": "SUBSTITUIR_APOS_wrangler_d1_create",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "DOCS", "bucket_name": "frota-documentos" }
  ],
  "triggers": { "crons": ["0 7 * * *"] },
  "vars": {
    "ENVIRONMENT": "production",
    "CF_ACCESS_TEAM_DOMAIN": "",
    "CF_ACCESS_AUD": "",
    "ALERT_FROM": "Frota Radical <alertas@frotaradical.pt>",
    "APP_URL": "https://frotaradical.pt"
  }
}
